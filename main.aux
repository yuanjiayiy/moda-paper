\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Left: Diversity vs. quality pareto front (Qwen3-8B base, thinking disabled).} The x-axis is Infinite-Chat response diversity (mean z-score of Disc./SBERT/EmbVendi) and the y-axis is general capability (mean benchmark accuracy). \textsc  {MoDA}\xspace  {} Pareto-dominates all the baselines, achieving better diversity and quality simultaneously. \textbf  {Right: Per-domain diversity and quality.} (Disc. = discriminator diversity, SBERT = SBERT embedding pairwise distance, E-V = E-Vendi score) and quality (Qual.), averaged over $n{=}3$ random seeds. Infinite-Chat quality is general capability accuracy (\%); all other domains use the native quality score. Bold marks the best value within each model group. Additional results can be found in Appx \ref {appx:generative diversity evaluation}. }}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig: domain application pareto}{{3}{8}{\textbf {Left: Diversity vs. quality pareto front (Qwen3-8B base, thinking disabled).} The x-axis is Infinite-Chat response diversity (mean z-score of Disc./SBERT/EmbVendi) and the y-axis is general capability (mean benchmark accuracy). \method {} Pareto-dominates all the baselines, achieving better diversity and quality simultaneously. \textbf {Right: Per-domain diversity and quality.} (Disc. = discriminator diversity, SBERT = SBERT embedding pairwise distance, E-V = E-Vendi score) and quality (Qual.), averaged over $n{=}3$ random seeds. Infinite-Chat quality is general capability accuracy (\%); all other domains use the native quality score. Bold marks the best value within each model group. Additional results can be found in Appx \ref {appx:generative diversity evaluation}}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Left: General capability retention (Pass@1 accuracy \%)}, averaged over $n=3$ random seeds. Bold marks the best value within each model group; underline marks the second-best value within the Qwen3-8B groups. Table with error bar can be found in Appendix \ref {appx:general capability retention} Table \ref {tab:general-capability-pass1-error-bar}. \textbf  {Right: General capability retention: pass@k accuracy.} Qwen3-8B base, thinking disabled models on the general capability suite average. Per-benchmark results are shown in Appendix \ref {appx:general capability retention} Figure \ref {fig:general capability pass@k thinking disabled}.}}{8}{figure.caption.13}\protected@file@percent }
\newlabel{fig:general capability retention}{{4}{8}{\textbf {Left: General capability retention (Pass@1 accuracy \%)}, averaged over $n=3$ random seeds. Bold marks the best value within each model group; underline marks the second-best value within the Qwen3-8B groups. Table with error bar can be found in Appendix \ref {appx:general capability retention} Table \ref {tab:general-capability-pass1-error-bar}. \textbf {Right: General capability retention: pass@k accuracy.} Qwen3-8B base, thinking disabled models on the general capability suite average. Per-benchmark results are shown in Appendix \ref {appx:general capability retention} Figure \ref {fig:general capability pass@k thinking disabled}}{figure.caption.13}{}}
